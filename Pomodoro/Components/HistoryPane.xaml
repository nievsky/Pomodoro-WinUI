<UserControl
    x:Class="Pomodoro.Components.HistoryPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pomodoro">

    <StackPanel BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="0,0,16,0">
        <TextBlock Text="Session History" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <ListView x:Name="historyListView" SelectionMode="Single" IsItemClickEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SessionRecord">
                    <Border Margin="0,8" Padding="8" Background="#F7F7F7" CornerRadius="6">
                        <StackPanel>
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Text="{x:Bind SessionTitle}" FontWeight="SemiBold" FontSize="16" Foreground="#222"/>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind TaskSummary}" Foreground="Gray" FontSize="12" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{x:Bind Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="14" Margin="8,0,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</UserControl>
