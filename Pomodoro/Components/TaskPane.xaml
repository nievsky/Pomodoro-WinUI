<UserControl
    x:Class="Pomodoro.Components.TaskPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pomodoro">

    <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBox x:Name="newTaskInput" PlaceholderText="What are you working on?" Width="250" />
            <Button x:Name="addTaskBtn" Content="Add"/>
        </StackPanel>

        <TextBlock Text="To Do" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <ListView x:Name="activeTaskListView" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TaskItem">
                    <CheckBox Content="{x:Bind Name}" Margin="0,5" Checked="OnTaskChecked"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Completed" FontSize="16" FontWeight="SemiBold" Foreground="Gray" Margin="0,10,0,0"/>
        <ListView x:Name="completedTaskListView" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TaskItem">
                    <CheckBox Content="{x:Bind Name}" IsChecked="True" Unchecked="OnTaskUnchecked" Foreground="Gray" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>

</UserControl>
