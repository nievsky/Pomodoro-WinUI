<Window
    x:Class="Pomodoro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pomodoro">

    <NavigationView x:Name="NavView" ItemInvoked="NavView_ItemInvoked" PaneDisplayMode="Top">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Focus" Tag="Focus" Icon="Clock" />
            <NavigationViewItem Content="Short Break" Tag="Break" Icon="Emoji2" />
        </NavigationView.MenuItems>

        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Session History" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <ListView Grid.Row="1" x:Name="HistoryListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SessionRecord">
                            <StackPanel Margin="0,8">
                                <TextBlock Text="{x:Bind SessionTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind TaskSummary}" Foreground="Gray" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" Padding="24,0,0,0" MaxWidth="600" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,20">
                    <TextBox x:Name="TimerDisplay" Text="25:00" FontSize="80" FontWeight="Bold" 
                             HorizontalAlignment="Center" TextAlignment="Center" 
                             BorderThickness="0" Background="Transparent"
                             LostFocus="TimerDisplay_LostFocus" />

                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                        <Button x:Name="ResetBtn" Content="🔄" Click="Reset_Click" FontSize="20" Background="Transparent" ToolTipService.ToolTip="Reset"/>
                        <Button x:Name="PrimaryActionBtn" Content="Start" Click="PrimaryAction_Click" Style="{StaticResource AccentButtonStyle}" Width="120" FontSize="18"/>
                        <Button x:Name="SkipBtn" Content="⏭" Click="Skip_Click" FontSize="20" Background="Transparent" ToolTipService.ToolTip="Skip Session"/>
                    </StackPanel>
                    <MenuFlyoutSeparator />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="NewTaskInput" PlaceholderText="What are you working on?" Width="250" KeyDown="NewTaskInput_KeyDown"/>
                            <Button Content="Add" Click="AddTask_Click"/>
                        </StackPanel>

                        <TextBlock Text="To Do" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ListView x:Name="ActiveTaskListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TaskItem">
                                    <CheckBox Content="{x:Bind Name}" Checked="Task_Checked" Margin="0,5"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="Completed" FontSize="16" FontWeight="SemiBold" Foreground="Gray" Margin="0,10,0,0"/>
                        <ListView x:Name="CompletedTaskListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TaskItem">
                                    <CheckBox Content="{x:Bind Name}" IsChecked="True" Unchecked="Task_Unchecked" Foreground="Gray" Margin="0,5"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Window>