<Window
    x:Class="Pomodoro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pomodoro">

    <NavigationView x:Name="NavView" ItemInvoked="NavView_ItemInvoked" PaneDisplayMode="Top">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Focus" Tag="Focus" Icon="Clock" />
            <NavigationViewItem Content="Short Break" Tag="Break" Icon="Emoji2" />
        </NavigationView.MenuItems>

        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" BorderBrush="LightGray" BorderThickness="0,0,1,0" Padding="0,0,16,0">
                <TextBlock Text="Session History" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <ListView x:Name="HistoryListView" SelectionMode="Single" ItemClick="HistoryListView_ItemClick" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SessionRecord">
                            <Border Margin="0,8" Padding="8" Background="#F7F7F7" CornerRadius="6">
                                <StackPanel>
                                    <Expander IsExpanded="False">
                                        <Expander.Header>
                                            <TextBlock Text="{x:Bind SessionTitle}" FontWeight="SemiBold" FontSize="16" Foreground="#222"/>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind TaskSummary}" Foreground="Gray" FontSize="12" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{x:Bind Tasks}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="14" Margin="8,0,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Grid Grid.Column="1" Padding="24,0,0,0" MaxWidth="600" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,20">
                    
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
                        <ProgressRing x:Name="TimerProgress" IsIndeterminate="False" Value="100" Maximum="100" 
                                      Width="280" Height="280" Foreground="#20E585" />
                        
                    <TextBox x:Name="TimerDisplay" 
                                Text="25:00" 
                                FontSize="80" 
                                FontWeight="Bold" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                TextAlignment="Center" 
                                BorderThickness="0" 
                                Background="Transparent"
                                LostFocus="TimerDisplay_LostFocus" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                        <Button x:Name="ResetBtn" Content="🔄" Click="Reset_Click" FontSize="20" Background="Transparent" ToolTipService.ToolTip="Reset"/>
                        <Button x:Name="PrimaryActionBtn" Content="Start" Click="PrimaryAction_Click" Style="{StaticResource AccentButtonStyle}" Width="120" FontSize="18"/>
                        <Button x:Name="SkipBtn" Content="⏭" Click="Skip_Click" FontSize="20" Background="Transparent" ToolTipService.ToolTip="Skip Session"/>
                    </StackPanel>
                    <MenuFlyoutSeparator Margin="0,20,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox x:Name="NewTaskInput" PlaceholderText="What are you working on?" Width="250" KeyDown="NewTaskInput_KeyDown"/>
                            <Button Content="Add" Click="AddTask_Click"/>
                        </StackPanel>

                        <TextBlock Text="To Do" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <ListView x:Name="ActiveTaskListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TaskItem">
                                    <CheckBox Content="{x:Bind Name}" Checked="Task_Checked" Margin="0,5"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="Completed" FontSize="16" FontWeight="SemiBold" Foreground="Gray" Margin="0,10,0,0"/>
                        <ListView x:Name="CompletedTaskListView" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TaskItem">
                                    <CheckBox Content="{x:Bind Name}" IsChecked="True" Unchecked="Task_Unchecked" Foreground="Gray" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Session details frame -->
                        <Frame x:Name="contentFrame" Margin="0,20,0,0" Height="200" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </NavigationView>
</Window>