<UserControl
    x:Class="Pomodoro.Components.TimerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="20" Margin="0,0,0,20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,0,0,8">
                <!-- RadioButtons: students will add Checked handlers in the exercise -->
                <RadioButton x:Name="FocusRadio" Content="Focus (25m)" GroupName="TimerMode" />
                <RadioButton x:Name="BreakRadio" Content="Short Break (5m)" GroupName="TimerMode" />
            </StackPanel>

            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
            <ProgressRing x:Name="timerProgress" IsIndeterminate="False" Value="100" Maximum="100" 
                          Width="280" Height="280" Foreground="#20E585" />

            <TextBox x:Name="timerDisplay" 
                        Text="25:00" 
                        FontSize="80" 
                        FontWeight="Bold" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        TextAlignment="Center" 
                        BorderThickness="0" 
                        Background="Transparent" />
            </Grid>

        <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
            <Button x:Name="resetBtn" Content="🔄" FontSize="20" Background="Transparent" ToolTipService.ToolTip="Reset"/>
            <Button x:Name="primaryActionBtn" Content="Start" Width="120" FontSize="18"/>
            <Button x:Name="skipBtn" Content="⏭" FontSize="20" Background="Transparent" ToolTipService.ToolTip="Skip Session"/>
        </StackPanel>

        <MenuFlyoutSeparator Margin="0,20,0,0"/>
        </StackPanel>
    </StackPanel>

</UserControl>
