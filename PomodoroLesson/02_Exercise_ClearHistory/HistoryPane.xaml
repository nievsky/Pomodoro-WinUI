<UserControl
    x:Class="Pomodoro.Components.HistoryPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pomodoro.Components">

    <Grid Padding="12">
        <StackPanel>
            <TextBlock Text="Session History" FontSize="16" Margin="0,0,0,8" />
            <ListView x:Name="HistoryListView" ItemsSource="{x:Bind SessionHistoryList}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SessionRecord">
                        <TextBlock Text="{x:Bind DisplayText}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Student adds: <Button Content="Clear History" Click="ClearHistory_Click" /> -->

        </StackPanel>
    </Grid>
</UserControl>
