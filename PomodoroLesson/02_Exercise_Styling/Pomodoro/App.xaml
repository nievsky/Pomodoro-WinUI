<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Pomodoro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Pomodoro">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Intentionally bad color theme for the styling exercise -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFF00FF" /> <!-- bright magenta -->
            <SolidColorBrush x:Key="AppForegroundBrush" Color="#FF00FF00" /> <!-- neon green -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF00" /> <!-- yellow accent -->

            <!-- Example global styles that students can fix -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AppForegroundBrush}" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
