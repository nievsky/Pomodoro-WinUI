<UserControl
    x:Class="Pomodoro.Components.TimerPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="20" Margin="0,0,0,20">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
            <ProgressRing x:Name="timerProgress" IsIndeterminate="False" Value="100" Maximum="100" 
                          Width="280" Height="280" Foreground="#20E585" />

            <TextBox x:Name="timerDisplay"
                        Text="25:00" 
                        FontSize="80" 
                        FontWeight="Bold" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        TextAlignment="Center" 
                        BorderThickness="0" 
                        Background="Transparent" />
        </Grid>


        <MenuFlyoutSeparator Margin="0,20,0,0"/>
    </StackPanel>

</UserControl>
